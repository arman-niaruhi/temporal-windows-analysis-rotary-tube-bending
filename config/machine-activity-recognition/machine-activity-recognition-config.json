    "training_config": {
      "training": true,
      "num_epochs": 100,
      "learning_rate": 1e-3,
      "patience": 4
    }
  },
  "analytics":true,
  "show_result_properties":{
    "store_plots": true,
    "store_plots_path": "results/activity_recognition" 
  },
  "inference_one_label_in_one":{
