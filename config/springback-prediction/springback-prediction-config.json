{
    "generalSetting": {
        "seed": 42
    },
    "inputPathParams": {
        "database_path": "data/processed/tube_geometry",
        "process_part": "All",
        "annotation_json_path": "data/ml/machine-and-movement_complete.json"
    },
    "preprocessingParams": {
        "random_seed": 42,
        "normalize": true,
        "scaler": "standard",
        "resample": false,
        "agg_metric": "mean",
        "window_num": 400,
        "split_config_path": "config/data-split-config/train_test_split_each_setup_80.json",
        "feature_indices": [
            1,
            3
        ],
        "annot_timesteps": [
            150,
            340,    
            820,
            1280
        ],
        "mandrel_extraction_annot_timesteps":[
            650, 
            820
        ]
    },
    "lstmTrainingParams": {
        "tcn_channels": [32, 64, 64],
        "tcn_kernel_size": 10,
        "tcn_dropout": 0.1,
        "pool": "mean",
        "train": true,
        "hidden_size": 32,
        "num_layers": 1,
        "dropout": 0.1,
        "fc_dropout": 0.1,
        "bidirectional": false,
        "lr": 3e-5,
        "weight_decay": 3e-5,
        "batch_size": 16,
        "max_epochs": 1000,
        "stop_early_min_delta":1e-4,
        "stop_early_patience":20,
        "schedular_factor": 0.5,
        "schedular_patience": 3,
        "gradient_clip":1.0,
        "verbose_every":2,
        "model_path": "models/spring_back"
    }
}
