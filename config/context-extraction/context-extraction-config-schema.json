{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ML Configuration Schema",
  "description": "Schema for machine learning pipeline configuration",
  "type": "object",
  "required": [
    "inputPathParams",
    "preprocessingParams",
    "trainingParams",
    "occlusionParams"
  ],
  "properties": {
    "generalSetting": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "default" : 42,
          "description": "Seed must be integer"
        }
      },
      "additionalProperties": false,
      "default": {
        "seed": 42
      }
    },
    "inputPathParams": {
      "type": "object",
      "required": [
        "database_path",
        "process_part",
        "annotation_json_path"
      ],
      "properties": {
        "database_path": {
          "type": "string",
          "default": "data/processed/tube_geometry.db",
          "description": "Path to the database file"
        },
        "process_part": {
          "type": "string",
          "enum": ["All", "Bending", "Clamping", "De-Clamping"],
          "description": "Machine part identifier - must be one of the 'All', 'Bending', 'Clamping', 'De-Clamping'"
        },
        "annotation_json_path": {
          "type": "string",
          "default": "data/ml/machine-and-movement_complete.json",
          "description": "Path to annotation JSON file"
        }
      },
      "additionalProperties": false
    },
    "preprocessingParams": {
      "type": "object",
      "required": [
        "to_58_excluded",
        "random_seed",
        "agg_metric",
        "window_num",
        "feature_indices"
      ],
      "properties": {
        "to_58_excluded": {
          "type": "boolean",
          "description": "Whether to exclude the experiments less equal than 58"
        },
        "random_seed": {
          "type": "integer",
          "description": "Random seed for preprocessing"
        },
        "agg_metric": {
          "type": "string",
          "description": "Aggregation metric"
        },
        "normalize": {
          "type": "boolean",
          "description": "Whether to normalize inputs and targets for training"
        },
        "window_num": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of windows"
        },
        "annot_timesteps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1750
          },
          "minItems": 1,
          "description": "Annotation timesteps"
        },
        "feature_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "minItems": 1,
          "description": "Feature indices to use"
        },
        "mandrel_extraction_annot_timesteps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Mandrel extraction annotation timesteps"
        }
      },
      "additionalProperties": false
    },
    "trainingParams": {
      "type": "object",
      "required": [
        "train",
        "hidden_dim",
        "lstm_layers",
        "dropout",
        "lr",
        "weight_decay",
        "batch_size",
        "max_epochs",
        "model_path"
      ],
      "properties": {
        "train": {
          "type": "boolean",
          "description": "Whether to train the model"
        },
        "hidden_dim": {
          "type": "integer",
          "minimum": 1,
          "description": "Hidden dimension size"
        },
        "lstm_layers": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of LSTM layers"
        },
        "dropout": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Dropout rate"
        },
        "lr": {
          "type": "number",
          "minimum": 0,
          "description": "Learning rate"
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0,
          "description": "Weight decay for regularization"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Batch size for training"
        },
        "max_epochs": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of training epochs"
        },
        "model_path": {
          "type": "string",
          "description": "Path to save/load model"
        }
      },
      "additionalProperties": false
    },
    "occlusionParams": {
      "type": "object",
      "required": [
        "occlusion_window_size",
        "occlusion_stride"
      ],
      "properties": {
        "occlusion_window_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Size of occlusion window"
        },
        "occlusion_stride": {
          "type": "integer",
          "minimum": 1,
          "description": "Stride for occlusion"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
